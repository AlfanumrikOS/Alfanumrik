{
  "root": true,
  "extends": "next/core-web-vitals",
  "plugins": [
    "@typescript-eslint",
    "alfanumrik"
  ],
  "rules": {
    "@typescript-eslint/no-explicit-any": "off",
    "@next/next/no-img-element": "warn",
    "react/no-unescaped-entities": "warn",
    "no-console": [
      "warn",
      {
        "allow": [
          "warn",
          "error"
        ]
      }
    ],
    "alfanumrik/no-raw-subject-imports": "error",
    "alfanumrik/no-canonical-write-outside-projector": "warn",
    "alfanumrik/no-direct-ai-calls": "off",
    "alfanumrik/no-direct-rag-rpc": "off",
    "alfanumrik/no-inline-taxonomy-reads": "warn"
  },
  "overrides": [
    {
      // ── Monorepo allowlist repair for alfanumrik/no-raw-subject-imports ──
      // The rule (eslint-plugin-alfanumrik/no-raw-subject-imports.js) documents
      // an allowlist of files where GRADE_SUBJECTS / SUBJECT_META /
      // getSubjectsForGrade / SUBJECT_BY_GRADE MAY legitimately be declared:
      // the subjects service itself and the deprecated compat shim. That
      // allowlist is matched with `file.includes('src/lib/constants.ts')` and
      // `file.includes('src/lib/subjects.ts')` — PRE-MONOREPO paths. After the
      // apps/* + packages/* migration the canonical files are
      // `packages/lib/src/constants.ts` and `packages/lib/src/subjects.ts`,
      // which do NOT contain the substring `src/lib/…`, so the rule fired on
      // the very files it is written to exempt.
      //
      // This surfaced only on 2026-07-28, when packages/ got a lint script for
      // the first time (they had never been linted — `--if-present` skipped
      // them silently). These are the 3 "real errors" from that audit: they are
      // allowlist path-drift, not a genuine subject-source-of-truth violation.
      //
      // Scope is deliberately narrow — exactly the two canonical files the rule
      // already names. Every other file under packages/ stays fully enforced.
      // DURABLE FIX (owner: whoever owns eslint-plugin-alfanumrik/): widen the
      // in-rule `isAllowed` check to match the monorepo paths, then delete this
      // override.
      "files": [
        "packages/lib/src/constants.ts",
        "packages/lib/src/subjects.ts",
        "packages/lib/src/subjects.types.ts"
      ],
      "rules": {
        "alfanumrik/no-raw-subject-imports": "off"
      }
    },
    {
      "files": [
        "src/__tests__/**",
        "src/**/*.test.{ts,tsx}",
        "src/**/*.spec.{ts,tsx}",
        "apps/*/src/__tests__/**",
        "apps/*/src/**/*.test.{ts,tsx}",
        "apps/*/src/**/*.spec.{ts,tsx}",
        "packages/*/src/__tests__/**",
        "packages/*/src/**/*.test.{ts,tsx}",
        "packages/*/src/**/*.spec.{ts,tsx}"
      ],
      "rules": {
        "alfanumrik/no-canonical-write-outside-projector": "off"
      }
    },
    {
      "files": [
        "src/app/**/*.{ts,tsx}",
        "src/components/**/*.{ts,tsx}"
      ],
      "excludedFiles": [
        "src/**/*.test.{ts,tsx}",
        "src/**/*.spec.{ts,tsx}",
        "src/__tests__/**",
        "apps/*/src/**/*.test.{ts,tsx}",
        "apps/*/src/**/*.spec.{ts,tsx}",
        "apps/*/src/__tests__/**",
        "packages/*/src/**/*.test.{ts,tsx}",
        "packages/*/src/**/*.spec.{ts,tsx}",
        "packages/*/src/__tests__/**"
      ],
      "rules": {
        "no-restricted-syntax": [
          "warn",
          {
            "selector": "JSXAttribute[name.name='style'] Literal[value=/^#[0-9a-fA-F]{3,8}$/]",
            "message": "Use design tokens inside style={{}}: prefer var(--token) over raw hex. See Phase 5B design-token sweep."
          },
          {
            "selector": "JSXAttribute[name.name='style'] TemplateElement[value.raw=/#[0-9a-fA-F]{3,8}/]",
            "message": "Use design tokens inside style={{}}: prefer var(--token) over raw hex. See Phase 5B design-token sweep."
          }
        ]
      }
    },
    {
      "files": [
        "src/app/**/*.{ts,tsx}",
        "src/components/**/*.{ts,tsx}"
      ],
      "excludedFiles": [
        "src/**/*.test.{ts,tsx}",
        "src/**/*.spec.{ts,tsx}",
        "src/__tests__/**",
        "apps/*/src/**/*.test.{ts,tsx}",
        "apps/*/src/**/*.spec.{ts,tsx}",
        "apps/*/src/__tests__/**",
        "packages/*/src/**/*.test.{ts,tsx}",
        "packages/*/src/**/*.spec.{ts,tsx}",
        "packages/*/src/__tests__/**"
      ],
      "rules": {
        "no-restricted-syntax": [
          "error",
          {
            "selector": "CallExpression[callee.name='alert']",
            "message": "alert() is forbidden in src/app/** and src/components/**. Use the toast component (import { toast } from '@/components/ui/toast') or a styled modal instead. (Phase E.3)"
          },
          {
            "selector": "CallExpression[callee.object.name='window'][callee.property.name='alert']",
            "message": "window.alert() is forbidden in src/app/** and src/components/**. Use the toast component (import { toast } from '@/components/ui/toast') or a styled modal instead. (Phase E.3)"
          }
        ]
      }
    },
    {
      "files": [
        "src/components/**/*.{ts,tsx}",
        "src/app/**/page.{ts,tsx}",
        "src/app/**/layout.{ts,tsx}",
        "src/app/**/template.{ts,tsx}",
        "src/app/**/loading.{ts,tsx}",
        "src/app/**/error.{ts,tsx}",
        "src/app/**/not-found.{ts,tsx}"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/lib/supabase-admin",
                  "**/lib/supabase-admin",
                  "../**/supabase-admin",
                  "../../**/supabase-admin"
                ],
                "message": "supabase-admin uses the service-role key and bypasses RLS. It MUST NOT be imported from client components, pages, layouts, or other client-executed files. Use a server API route (src/app/api/**) or a domain module (src/lib/domains/**) instead. See docs/architecture/DOMAIN_BOUNDARIES.md."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/app/**/*.{ts,tsx}",
        "src/components/**/*.{ts,tsx}",
        "src/lib/**/*.{ts,tsx}"
      ],
      "excludedFiles": [
        "src/lib/xp-rules.ts",
        "src/__tests__/**",
        "src/**/*.test.{ts,tsx}",
        "src/**/*.spec.{ts,tsx}",
        "apps/*/src/__tests__/**",
        "apps/*/src/**/*.test.{ts,tsx}",
        "apps/*/src/**/*.spec.{ts,tsx}",
        "packages/*/src/__tests__/**",
        "packages/*/src/**/*.test.{ts,tsx}",
        "packages/*/src/**/*.spec.{ts,tsx}"
      ],
      "rules": {
        "no-restricted-imports": [
          "warn",
          {
            "patterns": [
              {
                "group": [
                  "@/lib/xp-rules",
                  "**/lib/xp-rules",
                  "../**/xp-rules",
                  "../../**/xp-rules"
                ],
                "message": "@/lib/xp-rules is @deprecated. New code MUST import from @/lib/score-config (Performance Score) or @/lib/coin-rules (Foxy Coins) instead. Existing 17 imports remain for backward compat \u2014 see audit F19. Migration roadmap: docs/architecture/xp-deprecation.md (TBD)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/app/**/*.{ts,tsx}",
        "src/components/**/*.{ts,tsx}",
        "src/lib/**/*.{ts,tsx}"
      ],
      "excludedFiles": [
        "src/__tests__/**",
        "src/**/*.test.{ts,tsx}",
        "src/**/*.spec.{ts,tsx}",
        "apps/*/src/__tests__/**",
        "apps/*/src/**/*.test.{ts,tsx}",
        "apps/*/src/**/*.spec.{ts,tsx}",
        "packages/*/src/__tests__/**",
        "packages/*/src/**/*.test.{ts,tsx}",
        "packages/*/src/**/*.spec.{ts,tsx}"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/eval/rag/harness/**",
                  "../**/eval/rag/harness/*",
                  "../../**/eval/rag/harness/*",
                  "**/eval/**/harness/**",
                  "../eval/**",
                  "../../eval/**",
                  "../../../eval/**",
                  "../../../../eval/**"
                ],
                "message": "B1 RAG eval-harness (architect, B6): the offline read-only eval harness under eval/** (esp. eval/rag/harness/**) MUST NEVER be imported by production/client code (src/app, src/components, src/lib). It is build-time/offline-only and must not reach a shipped bundle. Only test files under src/__tests__/eval/** may import it. See docs/superpowers/plans/2026-06-13-rag-eval-harness.md (Task 8)."
              }
            ]
          }
        ]
      }
    }
  ]
}