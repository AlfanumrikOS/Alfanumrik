{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": "../..",
    "paths": {
      "@alfanumrik/lib/*": ["packages/lib/src/*"],
      "@alfanumrik/ui/*": ["packages/ui/src/*"],
      "@/*": ["apps/host/src/*"]
    }
  }
}
